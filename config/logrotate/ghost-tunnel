# ── Hostkita log rotation ──────────────────────────────────────────────────
# Rotates all Supervisor-managed logs to prevent disk saturation.
# Runs daily; keeps 14 days of compressed logs.

/var/log/supervisor/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    copytruncate
    su root root
}

/var/log/hostkita/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    copytruncate
    su root root
}
